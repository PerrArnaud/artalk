{% extends 'base.html.twig' %}

{% block title %}{{ motw.name }} - {{ motw.artist }}{% endblock %}

{% block body %}
<style>
    .motw-container {
        max-width: 900px;
        margin: 2em auto;
        padding: 0 20px;
    }
    
    .motw-detail {
        background: white;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        padding: 30px;
        margin-bottom: 30px;
    }
    
    .motw-header {
        display: flex;
        gap: 30px;
        margin-bottom: 20px;
    }
    
    .motw-visual-large {
        width: 250px;
        height: 250px;
        object-fit: cover;
        border-radius: 8px;
        background: #f0f0f0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 64px;
        color: #999;
    }
    
    .motw-visual-large img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 8px;
    }
    
    .motw-info {
        flex: 1;
    }
    
    .motw-title {
        font-size: 32px;
        font-weight: bold;
        margin: 0 0 15px 0;
        color: #333;
    }
    
    .motw-artist {
        font-size: 24px;
        color: #666;
        margin-bottom: 15px;
    }
    
    .motw-date {
        font-size: 14px;
        color: #999;
        margin-bottom: 5px;
    }
    
    .back-link {
        display: inline-block;
        margin-bottom: 20px;
        color: #007bff;
        text-decoration: none;
        font-size: 14px;
    }
    
    .back-link:hover {
        text-decoration: underline;
    }
    
    .comments-section {
        background: white;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        padding: 30px;
        margin-bottom: 30px;
    }
    
    .comments-title {
        font-size: 24px;
        font-weight: bold;
        margin-bottom: 20px;
        color: #333;
    }
    
    .comment {
        border-bottom: 1px solid #eee;
        padding: 20px 0;
    }
    
    .comment:last-child {
        border-bottom: none;
    }
    
    .comment-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
    }
    
    .comment-author {
        font-weight: bold;
        color: #333;
    }
    
    .comment-date {
        color: #999;
        font-size: 14px;
    }
    
    .comment-content {
        color: #555;
        line-height: 1.6;
        white-space: pre-wrap;
    }
    
    .comment-reply {
        margin-left: 40px;
        margin-top: 15px;
        padding-left: 20px;
        border-left: 3px solid #007bff;
        background: #f8f9fa;
        padding: 15px;
        border-radius: 4px;
    }
    
    .btn-reply {
        background: #28a745;
        color: white;
        padding: 5px 15px;
        border: none;
        border-radius: 4px;
        font-size: 14px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        margin-top: 10px;
    }
    
    .btn-reply:hover {
        background: #218838;
        color: white;
    }
    
    .pagination {
        display: flex;
        justify-content: center;
        list-style: none;
        padding: 20px 0 0 0;
        margin: 0;
        gap: 10px;
    }
    
    .pagination li {
        display: inline;
    }
    
    .pagination a,
    .pagination span {
        padding: 8px 12px;
        border: 1px solid #ddd;
        border-radius: 4px;
        color: #007bff;
        text-decoration: none;
    }
    
    .pagination .current {
        background: #007bff;
        color: white;
        border-color: #007bff;
    }
    
    .pagination a:hover {
        background: #e9ecef;
    }
    
    .reply-form-container {
        display: none;
        margin-top: 15px;
        padding: 15px;
        background: #f8f9fa;
        border-radius: 4px;
        border-left: 3px solid #28a745;
    }
    
    .reply-form-container.active {
        display: block;
    }
    
    .reply-form-header {
        font-weight: 600;
        color: #333;
        margin-bottom: 10px;
        font-size: 14px;
    }
    
    .btn-cancel {
        background: #6c757d;
        color: white;
        padding: 5px 15px;
        border: none;
        border-radius: 4px;
        font-size: 14px;
        cursor: pointer;
        margin-left: 10px;
    }
    
    .btn-cancel:hover {
        background: #5a6268;
    }
    
    .btn-submit-reply {
        background: #28a745;
        color: white;
        padding: 5px 15px;
        border: none;
        border-radius: 4px;
        font-size: 14px;
        cursor: pointer;
    }
    
    .btn-submit-reply:hover {
        background: #218838;
    }
    
    .no-comments {
        color: #999;
        text-align: center;
        padding: 20px;
    }
    
    .comment-form {
        background: white;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        padding: 30px;
    }
    
    .comment-form h3 {
        font-size: 20px;
        font-weight: bold;
        margin-bottom: 20px;
        color: #333;
    }
    
    .form-group {
        margin-bottom: 15px;
    }
    
    .form-group label {
        display: block;
        margin-bottom: 5px;
        font-weight: 500;
        color: #333;
    }
    
    .form-control {
        width: 100%;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 14px;
        font-family: inherit;
    }
    
    .form-control:focus {
        outline: none;
        border-color: #007bff;
    }
    
    .btn-submit {
        background: #007bff;
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 4px;
        font-size: 16px;
        cursor: pointer;
        transition: background 0.2s;
    }
    
    .btn-submit:hover {
        background: #0056b3;
    }
    
    .alert {
        padding: 15px;
        margin-bottom: 20px;
        border-radius: 4px;
    }
    
    .alert-success {
        background: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }
    
    .alert-error {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }
</style>

<div class="motw-container">
    <a href="{{ path('app_forum') }}" class="back-link">← Retour au forum</a>
    
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    
    {% for message in app.flashes('error') %}
        <div class="alert alert-error">{{ message }}</div>
    {% endfor %}
    
    <div class="motw-detail">
        <div class="motw-header">
            <div class="motw-visual-large">
                {% if motw.visual and motw.visual != '' %}
                    <img src="{{ motw.visual }}" alt="{{ motw.name }}" onerror="this.style.display='none'; this.parentElement.innerHTML='🎵';">
                {% else %}
                    🎵
                {% endif %}
            </div>
            <div class="motw-info">
                <h1 class="motw-title">{{ motw.name }}</h1>
                <div class="motw-artist">Par {{ motw.artist }}</div>
                <div class="motw-date">Date de sortie: {{ motw.date|date('d/m/Y') }}</div>
                <div class="motw-date">Publié le: {{ motw.datePost|date('d/m/Y') }}</div>
            </div>
        </div>
    </div>
    
    <div class="comments-section">
        <h2 class="comments-title">Commentaires ({{ pagination.getTotalItemCount }})</h2>
        
        {% if pagination.getTotalItemCount == 0 %}
            <div class="no-comments">
                Soyez le premier à commenter cette oeuvre !
            </div>
        {% else %}
            {% for comment in pagination %}
                <div class="comment">
                    <div class="comment-header">
                        <span class="comment-author">
                            {{ comment.user ? comment.user.name : 'Utilisateur inconnu' }}
                        </span>
                        <span class="comment-date">
                            {{ comment.createdAt|date('d/m/Y à H:i') }}
                        </span>
                    </div>
                    <div class="comment-content">{{ comment.content }}</div>
                    
                    {% if app.user %}
                        <button type="button" class="btn-reply" onclick="toggleReplyForm({{ comment.id }})">
                            Répondre
                        </button>
                        
                        {# Inline reply form #}
                        <div id="reply-form-{{ comment.id }}" class="reply-form-container">
                            <div class="reply-form-header">Répondre à {{ comment.user ? comment.user.name : 'ce commentaire' }}</div>
                            <form method="post" action="{{ path('app_forum_show', {'slug': motw.slug}) }}">
                                <input type="hidden" name="parentCommentId" value="{{ comment.id }}">
                                <div class="form-group">
                                    <textarea name="reply_content" class="form-control" rows="3" placeholder="Écrivez votre réponse..." required></textarea>
                                </div>
                                <button type="submit" class="btn-submit-reply">Publier la réponse</button>
                                <button type="button" class="btn-cancel" onclick="toggleReplyForm({{ comment.id }})">Annuler</button>
                            </form>
                        </div>
                    {% endif %}
                    
                    {# Display replies (one level deep only), excluding hidden ones #}
                    {% if comment.reply is not empty %}
                        {% for reply in comment.reply %}
                            {% if not reply.hidden %}
                            <div class="comment-reply">
                                <div class="comment-header">
                                    <span class="comment-author">
                                        {{ reply.user ? reply.user.name : 'Utilisateur inconnu' }}
                                    </span>
                                    <span class="comment-date">
                                        {{ reply.createdAt|date('d/m/Y à H:i') }}
                                    </span>
                                </div>
                                <div class="comment-content">{{ reply.content }}</div>
                            </div>
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                </div>
            {% endfor %}
            
            {# Pagination controls #}
            <div class="navigation">
                {{ knp_pagination_render(pagination) }}
            </div>
        {% endif %}
    </div>
    
    <div class="comment-form">
        <h3>Ajouter un commentaire</h3>
        
        {% if app.user %}
            {{ form_start(commentForm) }}
                <div class="form-group">
                    {{ form_label(commentForm.content) }}
                    {{ form_widget(commentForm.content, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(commentForm.content) }}
                </div>
                <button type="submit" class="btn-submit">Publier le commentaire</button>
            {{ form_end(commentForm) }}
        {% else %}
            <p>Vous devez être <a href="{{ path('app_login') }}">connecté</a> pour commenter.</p>
        {% endif %}
    </div>
</div>

<script>
function toggleReplyForm(commentId) {
    const formContainer = document.getElementById('reply-form-' + commentId);
    
    // Hide all other reply forms
    document.querySelectorAll('.reply-form-container').forEach(form => {
        if (form.id !== 'reply-form-' + commentId) {
            form.classList.remove('active');
        }
    });
    
    // Toggle current form
    formContainer.classList.toggle('active');
    
    // Focus on textarea when opening
    if (formContainer.classList.contains('active')) {
        const textarea = formContainer.querySelector('textarea');
        if (textarea) {
            textarea.focus();
        }
    }
}
</script>
{% endblock %}

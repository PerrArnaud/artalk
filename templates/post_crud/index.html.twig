{% extends 'base.html.twig' %}

{% block title %}Œuvres de la semaine{% endblock %}

{% block stylesheets %}
<style>
    body { background: #f0f2f5; }

    .crud-header {
        background: linear-gradient(135deg, #2c3e50 0%, #3d5166 100%);
        color: white;
        padding: 2rem 2.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .crud-header h1 {
        font-size: 1.8rem;
        font-weight: 700;
        letter-spacing: 0.5px;
    }
    .crud-header p {
        font-size: 0.9rem;
        opacity: 0.75;
        margin-top: 0.25rem;
    }
    .btn-new {
        background: #3498db;
        color: white;
        padding: 0.65rem 1.5rem;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: background 0.2s, transform 0.1s;
    }
    .btn-new:hover { background: #2980b9; transform: translateY(-1px); }

    .crud-container { max-width: 1200px; margin: 2rem auto; padding: 0 1.5rem; }

    .motw-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
    }
    .motw-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .motw-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    }
    .motw-card-img {
        width: 100%;
        height: 200px;
        object-fit: cover;
        display: block;
    }
    .motw-card-img-placeholder {
        width: 100%;
        height: 200px;
        background: #ecf0f1;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #95a5a6;
        font-size: 0.85rem;
    }
    .motw-card-body {
        padding: 1.25rem;
    }
    .motw-card-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 0.25rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .motw-card-artist {
        font-size: 0.85rem;
        color: #7f8c8d;
        margin-bottom: 0.5rem;
    }
    .motw-card-date {
        font-size: 0.78rem;
        color: #95a5a6;
        background: #f5f6fa;
        display: inline-block;
        padding: 0.2rem 0.6rem;
        border-radius: 20px;
        margin-bottom: 1rem;
    }
    .motw-card-actions {
        display: flex;
        gap: 0.5rem;
    }
    .btn-action {
        flex: 1;
        text-align: center;
        padding: 0.45rem 0;
        border-radius: 6px;
        font-size: 0.82rem;
        font-weight: 600;
        text-decoration: none;
        transition: opacity 0.2s;
    }
    .btn-action:hover { opacity: 0.85; }
    .btn-view  { background: #ecf5fb; color: #2980b9; }
    .btn-edit  { background: #eafaf1; color: #27ae60; }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        color: #95a5a6;
    }
    .empty-state svg { margin-bottom: 1rem; opacity: 0.4; }
    .empty-state p { font-size: 1.1rem; }
</style>
{% endblock %}

{% block body %}
<div class="crud-header">
    <div>
        <h1>Œuvres de la semaine</h1>
        <p>{{ m_o_t_ws|length }} œuvre{{ m_o_t_ws|length != 1 ? 's' : '' }} enregistrée{{ m_o_t_ws|length != 1 ? 's' : '' }}</p>
    </div>
    <a href="{{ path('app_post_crud_new') }}" class="btn-new">
        + Nouvelle œuvre
    </a>
</div>

<div class="crud-container">
    {% if m_o_t_ws is empty %}
        <div class="empty-state">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#95a5a6" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
            <p>Aucune œuvre enregistrée pour le moment.</p>
            <a href="{{ path('app_post_crud_new') }}" class="btn-new" style="display:inline-flex;margin-top:1rem;">+ Ajouter la première</a>
        </div>
    {% else %}
        <div class="motw-grid">
            {% for m_o_t_w in m_o_t_ws %}
                <div class="motw-card">
                    {% if m_o_t_w.visual %}
                        <img src="{{ m_o_t_w.visual }}" alt="{{ m_o_t_w.Name }}" class="motw-card-img">
                    {% else %}
                        <div class="motw-card-img-placeholder">Pas d'image</div>
                    {% endif %}
                    <div class="motw-card-body">
                        <div class="motw-card-title">{{ m_o_t_w.Name }}</div>
                        <div class="motw-card-artist">{{ m_o_t_w.Artist }}</div>
                        <div class="motw-card-date">{{ m_o_t_w.Date ? m_o_t_w.Date|date('d/m/Y') : '—' }}</div>
                        <div class="motw-card-actions">
                            <a href="{{ path('app_post_crud_show', {'id': m_o_t_w.id}) }}" class="btn-action btn-view">Voir</a>
                            <a href="{{ path('app_post_crud_edit', {'id': m_o_t_w.id}) }}" class="btn-action btn-edit">Modifier</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}MOTW{% endblock %}

{% block body %}
    <h1>MOTW</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ m_o_t_w.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ m_o_t_w.Name }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ m_o_t_w.Date ? m_o_t_w.Date|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Artist</th>
                <td>{{ m_o_t_w.Artist }}</td>
            </tr>
            <tr>
                <th>Visual</th>
                <td>{{ m_o_t_w.visual }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_post_crud_index') }}">back to list</a>

    <a href="{{ path('app_post_crud_edit', {'id': m_o_t_w.id}) }}">edit</a>

    {{ include('post_crud/_delete_form.html.twig') }}
{% endblock %}
